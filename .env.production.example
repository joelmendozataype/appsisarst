####################################################################
# SISARST - Plantilla para ambiente PRODUCCION
# Copiar como .env en el servidor y completar los valores marcados.
####################################################################

APP_NAME=SISARST
APP_ENV=production
APP_KEY=           # <-- php artisan key:generate
APP_DEBUG=false
APP_URL=https://sisarst.redsaludtayacaja.gob.pe   # <-- URL real

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error     # solo errores en produccion

# --- Base de datos ------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=red_salud_tayacaja
DB_USERNAME=sisarst_user   # <-- usuario dedicado (no root)
DB_PASSWORD=               # <-- completar

# --- Sesion -------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Correo -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=           # <-- servidor SMTP real
MAIL_PORT=587
MAIL_USERNAME=       # <-- completar
MAIL_PASSWORD=       # <-- completar
MAIL_FROM_ADDRESS="sisarst@redsaludtayacaja.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
